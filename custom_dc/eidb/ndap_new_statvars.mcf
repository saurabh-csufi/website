# NDAP Custom StatVars — Milk, TB, Unemployment
# Source: DAHD Basic Animal Husbandry Statistics, India TB Report 2024, MoSPI PLFS 2023-24

Node: dcid:NDAP_MilkProduction_Statewise
typeOf: dcid:StatisticalVariable
name: "Milk Production (State-wise)"
populationType: dcid:Agriculture
measuredProperty: dcid:production
statType: dcid:measuredValue
measurementDenominator: dcid:Count_Person
description: "Annual milk production by Indian state, in tonnes. Source: DAHD Basic Animal Husbandry Statistics, GoI."

Node: dcid:NDAP_MilkProduction_National
typeOf: dcid:StatisticalVariable
name: "Milk Production (National)"
populationType: dcid:Agriculture
measuredProperty: dcid:production
statType: dcid:measuredValue
description: "Annual national milk production in India, in tonnes (converted from million tonnes). Source: DAHD Basic Animal Husbandry Statistics, GoI."

Node: dcid:NDAP_MilkPCA_National
typeOf: dcid:StatisticalVariable
name: "Per Capita Milk Availability"
populationType: dcid:Person
measuredProperty: dcid:consumption
statType: dcid:measuredValue
description: "Per capita availability of milk in India in grams per day. Source: DAHD Basic Animal Husbandry Statistics, GoI."

Node: dcid:NDAP_TBNotifications_National
typeOf: dcid:StatisticalVariable
name: "TB Case Notifications (National)"
populationType: dcid:MedicalConditionIncident
measuredProperty: dcid:count
statType: dcid:measuredValue
description: "Annual TB case notifications in India (public + private sector). Source: India TB Report 2024, Central TB Division, MoHFW."

Node: dcid:NDAP_UnemploymentRate_Total
typeOf: dcid:StatisticalVariable
name: "Unemployment Rate (Total, Usual Status)"
populationType: dcid:Person
measuredProperty: dcid:unemploymentRate
statType: dcid:measuredValue
description: "State-wise unemployment rate (%) for persons aged 15+, rural+urban combined, usual status (ps+ss). Source: PLFS Annual Report 2023-24, MoSPI."

Node: dcid:NDAP_UnemploymentRate_Male
typeOf: dcid:StatisticalVariable
name: "Unemployment Rate (Male, Usual Status)"
populationType: dcid:Person
measuredProperty: dcid:unemploymentRate
statType: dcid:measuredValue
gender: dcid:Male
description: "State-wise unemployment rate (%) for males aged 15+, rural+urban combined, usual status. Source: PLFS 2023-24, MoSPI."

Node: dcid:NDAP_UnemploymentRate_Female
typeOf: dcid:StatisticalVariable
name: "Unemployment Rate (Female, Usual Status)"
populationType: dcid:Person
measuredProperty: dcid:unemploymentRate
statType: dcid:measuredValue
gender: dcid:Female
description: "State-wise unemployment rate (%) for females aged 15+, rural+urban combined, usual status. Source: PLFS 2023-24, MoSPI."

Node: dcid:NDAP_UnemploymentRate_Rural
typeOf: dcid:StatisticalVariable
name: "Unemployment Rate (Rural, Usual Status)"
populationType: dcid:Person
measuredProperty: dcid:unemploymentRate
statType: dcid:measuredValue
placeOfResidenceClassification: dcid:Rural
description: "State-wise rural unemployment rate (%) for persons aged 15+, usual status. Source: PLFS 2023-24, MoSPI."

Node: dcid:NDAP_UnemploymentRate_Urban
typeOf: dcid:StatisticalVariable
name: "Unemployment Rate (Urban, Usual Status)"
populationType: dcid:Person
measuredProperty: dcid:unemploymentRate
statType: dcid:measuredValue
placeOfResidenceClassification: dcid:Urban
description: "State-wise urban unemployment rate (%) for persons aged 15+, usual status. Source: PLFS 2023-24, MoSPI."

